{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "goal": { "type": "string" },
        "provider": { "type": "string" },
        "whop_user_id": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Saved favorite recipes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "recipeId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "recipeId"]
    },
    "PantryItem": {
      "title": "PantryItem",
      "description": "User pantry item",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name"]
    },
    "PremiumAccess": {
      "title": "PremiumAccess",
      "description": "Server-verified premium access lease from RevenueCat or Whop",
      "type": "object",
      "properties": {
        "source": { "type": "string", "enum": ["revenuecat", "whop"] },
        "entitlement": { "type": "string" },
        "valid_until": { "type": "string" }
      },
      "required": ["source", "entitlement", "valid_until"]
    },
    "WhopEntitlement": {
      "title": "WhopEntitlement",
      "description": "Server-managed Whop membership/payment state per MealMate user",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "whop_user_id": { "type": "string" },
        "membership_id": { "type": "string" },
        "tier": { "type": "string" },
        "status": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["user_id", "active"]
    },
    "WhopUser": {
      "title": "WhopUser",
      "description": "Server-only mapping between Whop OAuth subject IDs and MealMate user IDs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "whopUserId": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["userId", "whopUserId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles keyed by auth UID"
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "User favorite recipes"
    },
    "/users/{userId}/pantry/{pantryId}": {
      "schema": "PantryItem",
      "description": "User pantry items"
    },
    "/premium_access/{userId}": {
      "schema": "PremiumAccess",
      "description": "Server-only premium entitlement leases (RevenueCat and Whop)"
    },
    "/whop_entitlements/{userId}": {
      "schema": "WhopEntitlement",
      "description": "Server-only Whop membership entitlements"
    },
    "/whop_users/{whopUserId}": {
      "schema": "WhopUser",
      "description": "Server-only Whop OAuth user identity map"
    }
  }
}
