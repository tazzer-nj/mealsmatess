{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mealsmates-khaki.vercel.app" }],
      "destination": "https://mealsmates.site/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/public/announcements-cron",
      "schedule": "0 0 * * *"
    }
  ]
}
