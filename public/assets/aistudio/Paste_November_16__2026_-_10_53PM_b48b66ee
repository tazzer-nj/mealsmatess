        data: {
          id: item.id,
          name: name.trim() || item.name,
          description: description.trim() || undefined,
          cooking_time_minutes: time ? parseInt(time, 10) : null,
          servings: servings ? parseInt(servings, 10) : null,
        },
      });
      toast.success("Recipe updated");
      await onSaved();
