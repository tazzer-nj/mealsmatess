  const { error } = await supabaseAdmin.from("telemetry_events").insert({
    user_id: userId,
    kind: "marketplace",
    name: event.name,
    success: true,
    metadata: {
      restaurant_id: event.restaurant_id ?? null,
      branch_id: event.branch_id ?? null,
      menu_item_id: event.menu_item_id ?? null,
