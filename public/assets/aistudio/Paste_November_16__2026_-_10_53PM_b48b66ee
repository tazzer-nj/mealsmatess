          placeholder="Add an item…"
          className="h-11"
        />
        <Button type="submit" className="h-11">
          <Plus className="h-4 w-4" />
        </Button>
      </form>

      {checkedCount > 0 && (
        <div className="mt-3 flex justify-end">
          <Button variant="ghost" size="sm" onClick={clearChecked}>
