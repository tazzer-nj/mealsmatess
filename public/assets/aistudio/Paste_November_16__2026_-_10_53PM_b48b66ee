        custom_name: fav?.recipes?.name ?? null,
      });
      if (error) throw error;
      setAddingDay(null);
      setRecipeId("");
      refresh();
    } catch {
      toast.error("Couldn't add meal");
    } finally {
      setSaving(false);
    }
  }

