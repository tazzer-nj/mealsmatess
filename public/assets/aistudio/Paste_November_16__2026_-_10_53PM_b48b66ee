    return Array.from({ length: 7 }, (_, i) => {
      const d = new Date(start);
      d.setDate(start.getDate() + i);
      return d;
    });
  }, []);
  const fromISO = iso(week[0] ?? new Date());
  const toISO = iso(week[6] ?? new Date());

  const { data: plans } = useQuery({
