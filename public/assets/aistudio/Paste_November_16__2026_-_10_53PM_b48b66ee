    const visualPromise = wantsVisual
      ? generateVisualExplanation({ data: { prompt: text, scenes: 4, narration: true } })
          .then((visual) => patch(index, { visual, visualLoading: false }))
          .catch((err: unknown) =>
            patch(index, {
